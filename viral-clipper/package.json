{
  "name": "viral-clipper",
  "version": "1.0.0",
  "description": "FIFA viral moment scouter → Vugola AI clip generator → multi-platform publisher",
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "run:scout": "bun src/index.ts run",
    "run:draft": "bun src/index.ts run --draft",

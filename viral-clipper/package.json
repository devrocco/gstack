    "status": "bun src/index.ts status",
    "accounts": "bun src/index.ts accounts"
  },
  "dependencies": {
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11"
  }
}

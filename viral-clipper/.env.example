# Vugola AI API — get your key from vugolaai.com dashboard
VUGOLA_API_KEY=

# YouTube Data API key — metadata search only (no video upload)
# Get from: https://console.cloud.google.com/ → Enable YouTube Data API v3
YOUTUBE_API_KEY=

# Platform toggles (Vugola handles the actual social accounts)
# Start with only YouTube; enable others AFTER manual review in Vugola dashboard
ENABLE_YOUTUBE=true
ENABLE_INSTAGRAM=false
ENABLE_TIKTOK=false
ENABLE_FACEBOOK=false
ENABLE_TWITTER=false

# Safety defaults — only change these when you're ready to go live
LICENSE_MODE=metadata_only
SAFE_ASSET_MODE=true
PUBLISH_MODE=draft
REVIEW_REQUIRED=true
ENABLE_AUTO_PUBLISH=false

# Pipeline tuning
MIN_VIRALITY_SCORE=60
MAX_RISK_SCORE=40
MAX_CLIPS_PER_RUN=3
SCHEDULE_INTERVAL=*/30 * * * *

# ── Content strategy: 5 categories for maximum discoverability ──────────────
#
# Swap in any category block below, or keep all combined (recommended for first 100 uploads)
#
# World Cup 2026 only:
# KEYWORDS=FIFA World Cup 2026,World Cup 2026 goal,World Cup 2026 highlights,World Cup final 2026,best World Cup moment 2026
#
# Wonderkids only:
# KEYWORDS=football wonderkid 2026,next football superstar,young talent football,best young footballer 2026,football prodigy
#
# Viral football moments only:
# KEYWORDS=viral football moment,insane football skill,football trick shot,unbelievable football save,football skill compilation
#
# Match reactions only:
# KEYWORDS=World Cup fan reaction,football match reaction,goal reaction crowd,football stadium atmosphere 2026
#
# Football stories only:
# KEYWORDS=football player story,footballer journey,football motivation,football underdog story,from nothing to football star
#
# ALL FIVE combined — recommended for first 100 uploads:
KEYWORDS=FIFA World Cup 2026,World Cup 2026 goal,football wonderkid 2026,next football superstar,viral football moment,insane football skill,World Cup fan reaction,goal reaction crowd,football player story,footballer journey

# Reddit optional auth (increases rate limit from 60 to 100 req/min)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
